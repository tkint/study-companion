# The site served by the shared Caddy; deploy/caddy/deploy.py fills in DOMAIN from the app's .env.

{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		X-Robots-Tag "noindex, nofollow"
		-Server
	}

	# Strip secrets from access-log query strings. Cookies and Authorization headers are
	# already redacted by Caddy by default.
	# Named so it never collides with another site's access log on the shared Caddy.
	log study-companion {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri query {
					delete token
					delete wstoken
					delete code
				}
			}
		}
	}

	reverse_proxy study-companion-app:8000
}
