# Copy into ~/edge/sites/ and replace study.example.ch with DOMAIN from the app's .env.
# The edge is independent of the app and does not read its environment.

study.example.ch {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		X-Robots-Tag "noindex, nofollow"
		-Server
	}

	# Strip secrets from access-log query strings. Cookies and Authorization headers are
	# already redacted by Caddy by default.
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri query {
					delete token
					delete wstoken
					delete code
				}
			}
		}
	}

	reverse_proxy study-companion-app:8000
}
