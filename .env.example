# Copy to .env and fill in. Never commit .env.

# Public hostname; its DNS record must point to this server. Caddy gets the certificate.
DOMAIN=study.example.ch

# Image tag to run (e.g. 0.1.0). "latest" follows the newest release.
IMAGE_TAG=latest

# Web UI password (at least 12 characters).
APP_PASSWORD=change-me-to-a-long-password

# Signs session cookies (and later OAuth tokens). Generate with: openssl rand -hex 32
SECRET_KEY=

# Moodle site and token (used from M1 onward).
MOODLE_URL=https://moodle.example.ch
MOODLE_TOKEN=

# Optional
# SESSION_MAX_AGE=604800
# COOKIE_SECURE=true
