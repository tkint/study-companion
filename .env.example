# Copy to .env and fill in. Never commit .env.

# Public hostname; also set it in ~/edge/sites/study-companion.caddy.
# Its DNS record must point to this server. The shared Caddy gets the certificate.
DOMAIN=study.example.ch

# Image tag to run (e.g. 0.1.0). "latest" follows the newest release.
IMAGE_TAG=latest

# Initial web UI password (at least 12 characters), used on the first start only.
# Change it later on the Settings page; after that this value is ignored.
APP_PASSWORD=change-me-to-a-long-password

# Signs session cookies and encrypts the stored Moodle token. Keep a copy somewhere safe.
# Generate with: openssl rand -hex 32
SECRET_KEY=

# Moodle site and token are set on the Settings page (https://DOMAIN/settings).
# Optionally pre-fill them here; they are imported once, on the first start only.
# MOODLE_URL=https://moodle.example.ch
# MOODLE_TOKEN=

# Optional
# SYNC_INTERVAL_HOURS=6      # 0 turns the scheduled sync off
# MOODLE_MAX_FILE_MB=200     # bigger files (videos) are listed but not downloaded
# MOODLE_RATE_LIMIT=2        # Moodle requests per second
# SESSION_MAX_AGE=604800
# COOKIE_SECURE=true
# TIMEZONE=Europe/Zurich    # dates in Claude's tools and prompts
# OAUTH_REDIRECT_HOSTS=claude.ai,claude.com,localhost,127.0.0.1
# To also allow Gemini and/or ChatGPT, list them explicitly, e.g.:
# OAUTH_REDIRECT_HOSTS=claude.ai,claude.com,localhost,127.0.0.1,oauth-redirect.googleusercontent.com,oauth-redirect-sandbox.googleusercontent.com,oauth-redirect-test.googleusercontent.com,chatgpt.com
# OAUTH_ACCESS_TTL=3600
# OAUTH_REFRESH_TTL=2592000
